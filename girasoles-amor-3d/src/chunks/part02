function createTextSprite(text, fontSize=66, width=1500, lineHeight=1.25) {
  const c=document.createElement('canvas'); c.width=width; c.height=420;
  const ctx=c.getContext('2d');
  ctx.clearRect(0,0,c.width,c.height);
  ctx.textAlign='center'; ctx.textBaseline='middle';
  ctx.shadowColor='rgba(60,30,0,.45)'; ctx.shadowBlur=22;
  ctx.fillStyle='#fff3cf';
  ctx.font=`600 ${fontSize}px "Cormorant Garamond", Georgia, serif`;
  const words=text.split(' '); const maxW=width*.84; const lines=[]; let line='';
  for(const w of words) {
    const test=(line+' '+w).trim();
    if(ctx.measureText(test).width>maxW && line) { lines.push(line); line=w; } else line=test;
  }
  if(line) lines.push(line);
  const lh=fontSize*lineHeight;
  const y0=c.height/2-(lines.length-1)*lh/2;
  lines.forEach((ln,i)=>ctx.fillText(ln,c.width/2,y0+i*lh));
  const tex=new THREE.CanvasTexture(c); tex.colorSpace=THREE.SRGBColorSpace;
  const mat=new THREE.SpriteMaterial({ map:tex, transparent:true, opacity:0, depthWrite:false });
  const sp=new THREE.Sprite(mat); sp.scale.set(10.5,2.95,1); scene.add(sp); return sp;
}
