function clamp01(v) { return Math.min(1, Math.max(0, v)); }
function smooth(v) { v = clamp01(v); return v * v * (3 - 2 * v); }
function smoother(v) { v = clamp01(v); return v * v * v * (v * (v * 6 - 15) + 10); }
function range(t, a, b) { return clamp01((t - a) / (b - a)); }
function lerp(a, b, t) { return a + (b - a) * t; }

function makeGradientSky() {
  const c = document.createElement('canvas');
  c.width = 16; c.height = 512;
  const ctx = c.getContext('2d');
  const g = ctx.createLinearGradient(0, 0, 0, 512);
  g.addColorStop(0, '#5478a4');
  g.addColorStop(0.45, '#a8bad1');
  g.addColorStop(0.73, '#efd3a8');
  g.addColorStop(1, '#8b5e2e');
  ctx.fillStyle = g; ctx.fillRect(0, 0, 16, 512);
  const tex = new THREE.CanvasTexture(c);
  tex.colorSpace = THREE.SRGBColorSpace;
  return tex;
}

